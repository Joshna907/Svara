# Created in the LiveKit Cloud dashboard (never commit the real values).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Agent identity.
LIVEKIT_AGENT_NAME=digital-twin
TWIN_NAME=Jothsana
PROFILE_PATH=knowledge/personal_profile.md

# LiveKit Inference models. These defaults need no additional provider keys.
STT_MODEL=assemblyai/universal-3-5-pro
STT_LANGUAGE=en
LLM_MODEL=google/gemma-4-31b-it
TTS_MODEL=fishaudio/s2.1-pro
TTS_VOICE=fa4c9eb3dccc4806b382b40d61c6b10a

# LiveKit Cloud feature. Set false when self-hosting LiveKit.
ENABLE_NOISE_CANCELLATION=true

# Set false when testing through laptop speakers to prevent acoustic echo from
# interrupting the agent. Keep true for the final hosted demo.
ALLOW_INTERRUPTION=true
